{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "laravel-boost",
  "version": "0.1.1",
  "description": "Inspect and debug the active Laravel app with Laravel Boost; requires PHP and Laravel Boost in the project.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/anthropics/claude-plugins-official/tree/ac996c0dde7fb2a9f805cd5277ffc95ecd44a321/external_plugins/laravel-boost",
  "repository": "https://github.com/BANG404/openagent-laravel-boost",
  "author": {
    "name": "Laravel"
  },
  "extensions": {
    "openagent": {
      "compatibility": {
        "plugin_protocol": {
          "min": 1,
          "max": 1
        }
      },
      "capabilities": [
        "skills",
        "mcp",
        "commands"
      ],
      "mcp_tool_mode": "relay",
      "mcp_tool_modes": {
        "setup": "direct"
      },
      "commands": [
        {
          "id": "setup",
          "label": "Setup",
          "description": "Review connection prerequisites",
          "argument": "none",
          "command": "bin/command.mjs"
        }
      ],
      "i18n": {
        "supported_locales": [
          "en",
          "zh"
        ],
        "default_locale": "en",
        "translations": {
          "en": {
            "display_name": "Laravel Development",
            "description": "Inspect and debug the active Laravel app with Laravel Boost; requires PHP and Laravel Boost in the project.",
            "commands.setup.label": "Setup",
            "commands.setup.description": "Review connection prerequisites"
          },
          "zh": {
            "display_name": "Laravel 开发助手",
            "description": "使用 Laravel Boost 查看和调试当前 Laravel 应用，需要项目已安装 PHP 和 Laravel Boost。",
            "commands.setup.label": "配置",
            "commands.setup.description": "查看连接要求"
          }
        }
      }
    }
  }
}
